: 1787677044:0;#!/usr/bin/env bash\
choice=$(printf "Lock\nSuspend\nReboot\nShutdown" | rofi -dmenu -i -p "Power")\
case "$choice" in\
  Lock)     loginctl lock-session ;;\
  Suspend)  systemctl suspend ;;\
  Reboot)   systemctl reboot ;;\
  Shutdown) systemctl poweroff ;;\
esac
