@theme "/dev/null"

* {
    bg:         #131316;
    bg-alt:     #1a1a1f;
    border-col: #272730;
    fg:         #c8c8d4;
    fg-bright:  #f0f0f5;
    accent:     #b57bee;
    accent-dim: #7c4db0;
    urgent:     #dc5050;
}

window {
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          8px;
    width:            180px;
    location:         center;
    x-offset:         0;
    y-offset:         0;
}

mainbox {
    background-color: transparent;
    children:         [listview];
    spacing:          0px;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            4;
    spacing:          2px;
    padding:          4px;
    fixed-height:     false;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          10px 14px;
    border-radius:    6px;
    orientation:      horizontal;
    spacing:          12px;
    cursor:           pointer;
}

element selected {
    background-color: @bg-alt;
    text-color:       @accent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "JetBrainsPropo Nerd Font 12";
}
