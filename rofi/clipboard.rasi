@theme "/dev/null"
@import "colors.rasi"

* {
    font:               "JetBrains Mono Nerd Font 11";
    background-color:   transparent;
    text-color:         @fg;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

window {
    location:           center;
    width:              560px;
    border-radius:      24px;
    background-color:   @bg;
    border:             1px solid;
    border-color:       @border-col;
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   @bg-alt;
    border-color:       @accent;
    border:             2px solid;
    border-radius:      16px;
    padding:            8px 16px;
    spacing:            8px;
    children:           [prompt, entry];
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    vertical-align:     0.5;
}

entry {
    background-color:   transparent;
    text-color:         @fg-bright;
    placeholder:        "Search clipboard…";
    placeholder-color:  @fg;
    vertical-align:     0.5;
}

listview {
    background-color:   transparent;
    margin:             12px 0 0;
    lines:              10;
    columns:            1;
    fixed-height:       false;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    text-color:         @fg;
    padding:            8px 16px;
    border-radius:      16px;
    cursor:             pointer;
}

element selected {
    background-color:   @bg-alt;
    text-color:         @fg-bright;
    border:             1px solid;
    border-color:       @border-col;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}
