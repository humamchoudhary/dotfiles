[global]
    monitor = 0
    follow = keyboard
    geometry = "300x5-8+8"
    indicate_hidden = yes
    shrink = no
    transparency = 0
    notification_height = 0
    separator_height = 1
    padding = 6
    horizontal_padding = 8
    text_icon_padding = 8
    frame_width = 1
    frame_color = "#0a0a0a"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = JetBrains Mono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 0
    max_icon_size = 16
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true

[urgency_low]
    background = "#000000"
    foreground = "#777777"
    frame_color = "#0a0a0a"
    timeout = 3

[urgency_normal]
    background = "#000000"
    foreground = "#999999"
    frame_color = "#0a0a0a"
    timeout = 5

[urgency_critical]
    background = "#000000"
    foreground = "#cc4444"
    frame_color = "#1a0a0a"
    timeout = 0

[play_sound]
    summary = "*"
    script = "/usr/bin/true"